# Variáveis de ambiente da API Java (Confere) - nunca commitar valores reais
SPRING_PROFILES_ACTIVE=dev

# Banco de dados (Oracle em produção / profile oracle)
DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
DB_USER=confere
DB_PASSWORD=troque-em-producao

# JWT (HS256, mínimo 32 bytes; mesma chave compartilhada com a API .NET)
JWT_SECRET=confere-dev-secret-key-com-no-minimo-32-bytes-seguros

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Serviço de IA em Python
IA_BASE_URL=http://localhost:8000
IA_API_KEY=troque-em-producao

# Spring AI / LLM
LLM_API_KEY=sk-troque-em-producao
LLM_MODEL=gpt-4o-mini
